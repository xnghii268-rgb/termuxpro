#!/data/data/com.termuxpro.app/files/usr/bin/sh

if tty >/dev/null 2>&1 && [ $# = 0 ] && [ ! -f ~/.hushlogin ] && [ -z "$TERMUX_HUSHLOGIN" ]; then
	if [ -f ~/.termux/motd.sh ]; then
		[ ! -x ~/.termux/motd.sh ] && chmod u+x ~/.termux/motd.sh
		~/.termux/motd.sh
	elif [ -f /data/data/com.termuxpro.app/files/usr/etc/motd.sh ]; then
		/data/data/com.termuxpro.app/files/usr/bin/bash /data/data/com.termuxpro.app/files/usr/etc/motd.sh
	elif [ -f /data/data/com.termuxpro.app/files/usr/etc/motd ]; then
		cat /data/data/com.termuxpro.app/files/usr/etc/motd
	fi
else
	unset TERMUX_HUSHLOGIN
fi

if [ -G ~/.termux/shell ]; then
	export SHELL="`realpath ~/.termux/shell`"
else
	for file in /data/data/com.termuxpro.app/files/usr/bin/bash /data/data/com.termuxpro.app/files/usr/bin/sh /system/bin/sh; do
		if [ -x $file ]; then
			export SHELL=$file
			break
		fi
	done
fi

if [ -f "/data/data/com.termuxpro.app/files/usr/lib/libtermuxpro-path.so" ]; then
	export LD_PRELOAD="/data/data/com.termuxpro.app/files/usr/lib/libtermuxpro-path.so:/data/data/com.termuxpro.app/files/usr/lib/libtermux-exec.so"
elif [ -f "/data/data/com.termuxpro.app/files/usr/lib/libtermux-exec.so" ]; then
	export LD_PRELOAD="/data/data/com.termuxpro.app/files/usr/lib/libtermux-exec.so"
fi

if [ -f /data/data/com.termuxpro.app/files/usr/etc/termux-login.sh ]; then
	. /data/data/com.termuxpro.app/files/usr/etc/termux-login.sh
fi

if [ -n "$TERM" ]; then
	exec "$SHELL" -l "$@"
else
	exec "$SHELL" "$@"
fi

<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Top Slim Glass Session Chips Bar -->
                <HorizontalScrollView
                    android:id="@+id/session_chips_scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:scrollbars="none"
                    android:background="@drawable/bg_session_chips_bar"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="5dp">

                    <LinearLayout
                        android:id="@+id/session_chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/session_chips_scroll_view"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

                <!-- Liquid Glass Floating Bottom Navigation Bar -->
                <LinearLayout
                    android:id="@+id/floating_bottom_nav_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="12dp"
                    android:elevation="8dp"
                    android:background="@drawable/bg_floating_glass_nav"
                    android:paddingHorizontal="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 1. Terminal -->
                    <LinearLayout
                        android:id="@+id/nav_item_terminal"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_nav_terminal"
                            app:tint="#FF3C70" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terminal"
                            android:textColor="#FF3C70"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 2. Phiên -->
                    <LinearLayout
                        android:id="@+id/nav_item_sessions"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_nav_sessions"
                            app:tint="#9CA3AF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phiên"
                            android:textColor="#9CA3AF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 3. Lệnh -->
                    <LinearLayout
                        android:id="@+id/nav_item_command"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_nav_command"
                            app:tint="#9CA3AF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lệnh"
                            android:textColor="#9CA3AF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 4. Ảnh -->
                    <LinearLayout
                        android:id="@+id/nav_item_image"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_nav_image"
                            app:tint="#9CA3AF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ảnh"
                            android:textColor="#9CA3AF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 5. Cài đặt -->
                    <LinearLayout
                        android:id="@+id/nav_item_settings"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_settings"
                            app:tint="#9CA3AF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cài đặt"
                            android:textColor="#9CA3AF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="@drawable/glass_drawer_background">

                <!-- Glass Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Termux Pro"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/drawer_session_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phiên làm việc"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_settings"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="#94A3B8" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#26FFFFFF" />

                <!-- Sessions List -->
                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingVertical="8dp"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#26FFFFFF" />

                <!-- Glass Bottom Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/toggle_keyboard_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_drawer_toggle_kbd_btn"
                        android:layout_marginEnd="8dp"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <TextView
                        android:id="@+id/new_session_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_drawer_new_session_btn"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_extra_keys"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>

<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Living Glass Background Layer (Subtle orbs, scanlines, gyro parallax) -->
                <com.termux.app.ui.LiquidBackdropView
                    android:id="@+id/liquid_backdrop_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Floating Glass Top Bar (Terminal Chrome) -->
                <LinearLayout
                    android:id="@+id/terminal_top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_session_chips_bar">

                    <!-- Back to Home Chevron Button -->
                    <FrameLayout
                        android:id="@+id/terminal_top_bar_btn_home"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_glass_round_btn"
                        android:contentDescription="Trang chủ">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chevron_left"
                            app:tint="#F2EDE4" />
                    </FrameLayout>

                    <!-- Session Chips Scroll -->
                    <HorizontalScrollView
                        android:id="@+id/session_chips_scroll_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/session_chips_container"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>

                    <!-- New Session Button (+) -->
                    <FrameLayout
                        android:id="@+id/terminal_top_bar_btn_new_session"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_glass_round_btn"
                        android:contentDescription="Phiên mới">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus_new"
                            app:tint="#3DDC97" />
                    </FrameLayout>

                    <!-- Overflow Menu Button (...) -->
                    <FrameLayout
                        android:id="@+id/terminal_top_bar_btn_overflow"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_glass_round_btn"
                        android:contentDescription="Tùy chọn">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_more_dots"
                            app:tint="#F2EDE4" />
                    </FrameLayout>
                </LinearLayout>

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/terminal_top_bar"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

                <!-- Liquid Glass Menu Hub Screen (Bento Grid, No Dead Area) -->
                <ScrollView
                    android:id="@+id/menu_hub_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="96dp">

                        <!-- Glass App Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@mipmap/ic_launcher"
                                android:contentDescription="Termux Pro Logo" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Termux Pro"
                                    android:textColor="#F2EDE4"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="-0.02" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Liquid Glass Edition"
                                    android:textColor="#9E988F"
                                    android:textSize="12sp"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/menu_hub_session_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 phiên đang chạy"
                                android:textColor="#3DDC97"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_menu_badge_active"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp" />
                        </LinearLayout>

                        <!-- Hero Card: Active Session (Raised Glass) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_menu_hero_card"
                            android:padding="20dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="PHIÊN TERMINAL HIỆN TẠI"
                                    android:textColor="#3DDC97"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06" />

                                <TextView
                                    android:id="@+id/menu_hero_status_dot"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sẵn sàng"
                                    android:textColor="#3DDC97"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/menu_hero_session_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Phiên 1 : bash"
                                android:textColor="#F2EDE4"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp" />

                            <!-- Live Terminal Output Preview -->
                            <TextView
                                android:id="@+id/menu_hero_terminal_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="54dp"
                                android:maxLines="4"
                                android:ellipsize="end"
                                android:background="#26000000"
                                android:padding="10dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="16dp"
                                android:fontFamily="monospace"
                                android:textSize="12sp"
                                android:textColor="#9E988F"
                                android:text="~ $ \n~ $ Termux Pro Liquid Glass ready.\n~ $ bash session active." />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/menu_btn_resume_terminal"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1.3"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/bg_menu_hero_btn"
                                    android:gravity="center"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_prompt_chevron"
                                        app:tint="#0E0F11"
                                        android:layout_marginEnd="8dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Vào Terminal"
                                        android:textColor="#0E0F11"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/menu_btn_new_session"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1.0"
                                    android:background="@drawable/bg_menu_secondary_btn"
                                    android:gravity="center"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_plus_new"
                                        app:tint="#F2EDE4"
                                        android:layout_marginEnd="6dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Phiên Mới"
                                        android:textColor="#F2EDE4"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Section: Quick Actions Hub -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRUNG TÂM TIỆN ÍCH &amp; TÁC VỤ"
                            android:textColor="#9E988F"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="12dp" />

                        <!-- Bento Row 1: Command Palette (Wide Card) -->
                        <LinearLayout
                            android:id="@+id/menu_card_commands"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_menu_hub_card"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_menu_secondary_btn"
                                    android:padding="7dp"
                                    android:src="@drawable/ic_nav_command"
                                    app:tint="#F2EDE4" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Kho Lệnh Nhanh"
                                        android:textColor="#F2EDE4"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Truy cập và thực thi lệnh tiện ích"
                                        android:textColor="#9E988F"
                                        android:textSize="12sp"
                                        android:layout_marginTop="1dp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MỞ"
                                    android:textColor="#3DDC97"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Command Chips Preview -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="pkg update &amp;&amp; pkg upgrade"
                                    android:background="@drawable/bg_menu_cmd_chip"
                                    android:textColor="#9E988F"
                                    android:textSize="11sp"
                                    android:fontFamily="monospace"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="git status"
                                    android:background="@drawable/bg_menu_cmd_chip"
                                    android:textColor="#9E988F"
                                    android:textSize="11sp"
                                    android:fontFamily="monospace"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Bento Row 2: AI Hub (Tall Left) + Stacked Right (Sessions & Image) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <!-- AI Coding Hub (Tall Card) -->
                            <LinearLayout
                                android:id="@+id/menu_card_ai"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_menu_hub_card"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_menu_secondary_btn"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_ai_agent"
                                    app:tint="#F2EDE4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI Coding Hub"
                                    android:textColor="#F2EDE4"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="12dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Antigravity &amp; Gemini CLI trợ lý lập trình"
                                    android:textColor="#9E988F"
                                    android:textSize="12sp"
                                    android:layout_marginTop="4dp" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CHẠY NGAY"
                                    android:textColor="#3DDC97"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>

                            <!-- Stacked Right Column: Sessions & Image Helper -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.0"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <!-- Sessions Manager Card -->
                                <LinearLayout
                                    android:id="@+id/menu_card_sessions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_menu_hub_card"
                                    android:orientation="vertical"
                                    android:padding="14dp"
                                    android:layout_marginBottom="12dp"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_menu_secondary_btn"
                                        android:padding="7dp"
                                        android:src="@drawable/ic_nav_sessions"
                                        app:tint="#F2EDE4" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Quản Lý Phiên"
                                        android:textColor="#F2EDE4"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Chuyển đổi &amp; đổi tên"
                                        android:textColor="#9E988F"
                                        android:textSize="11sp"
                                        android:layout_marginTop="1dp" />
                                </LinearLayout>

                                <!-- Image & Media Card -->
                                <LinearLayout
                                    android:id="@+id/menu_card_image"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_menu_hub_card"
                                    android:orientation="vertical"
                                    android:padding="14dp"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_menu_secondary_btn"
                                        android:padding="7dp"
                                        android:src="@drawable/ic_nav_image"
                                        app:tint="#F2EDE4" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ảnh &amp; Media"
                                        android:textColor="#F2EDE4"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Dán screenshot, OCR"
                                        android:textColor="#9E988F"
                                        android:textSize="11sp"
                                        android:layout_marginTop="1dp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Bento Row 3: Themes & Settings -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <!-- Card: Themes & Glass -->
                            <LinearLayout
                                android:id="@+id/menu_card_theme"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_menu_hub_card"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_menu_secondary_btn"
                                    android:padding="7dp"
                                    android:src="@drawable/ic_palette_theme"
                                    app:tint="#F2EDE4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Theme &amp; Giao Diện"
                                    android:textColor="#F2EDE4"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Liquid Glass Pro"
                                    android:textColor="#9E988F"
                                    android:textSize="11sp"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                            <!-- Card: Settings -->
                            <LinearLayout
                                android:id="@+id/menu_card_settings"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_menu_hub_card"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_menu_secondary_btn"
                                    android:padding="7dp"
                                    android:src="@drawable/ic_settings"
                                    app:tint="#F2EDE4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cài Đặt Hệ Thống"
                                    android:textColor="#F2EDE4"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bàn phím, Shell, Sao lưu"
                                    android:textColor="#9E988F"
                                    android:textSize="11sp"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Bottom Glass Strip: Helpful tip (fills the space naturally) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_menu_cmd_chip"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mẹo:"
                                android:textColor="#3DDC97"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Chạm đúp vào màn hình terminal để sao chép nhanh văn bản."
                                android:textColor="#9E988F"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>

                <!-- Liquid Drop Floating Glass Tab Bar -->
                <com.termux.app.ui.LiquidTabBar
                    android:id="@+id/liquid_tab_bar"
                    android:layout_width="320dp"
                    android:layout_height="54dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="14dp"
                    android:elevation="10dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="@drawable/glass_drawer_background">

                <!-- Glass Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Termux Pro"
                            android:textColor="#F2EDE4"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/drawer_session_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 phiên đang mở · 1 đang chạy"
                            android:textColor="#9E988F"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:contentDescription="@string/action_open_settings" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#26FFFFFF" />

                <!-- Sessions List -->
                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingVertical="8dp"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#26FFFFFF" />

                <!-- Glass Bottom Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/toggle_keyboard_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#F2EDE4"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_drawer_toggle_kbd_btn"
                        android:layout_marginEnd="10dp"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <TextView
                        android:id="@+id/new_session_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:textColor="#0E0F11"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_drawer_new_session_btn"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_extra_keys"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
